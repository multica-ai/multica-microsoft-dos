    {
      "id": "dos-cursor",
      "type": "toggle",
      "label": {
        "en": "Blinking cursor after headings",
        "zh-Hans": "标题后的闪烁光标",
        "zh-Hant": "標題後的閃爍游標",
        "ja": "見出しの後に点滅カーソル",
        "ko": "제목 뒤 깜박이는 커서",

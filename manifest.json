      "default": "prompt",
      "choices": [
        {
          "value": "prompt",
          "label": {
            "en": "C:\\> prompt",
            "zh-Hans": "C:\\> 命令行",
            "zh-Hant": "C:\\> 命令列",
            "ja": "C:\\> プロンプト",
            "ko": "C:\\> 프롬프트",

            "es": "Fósforo verde",
            "fr": "Phosphore vert"
          },
          "swatch": "#33FF33"
        }
      ]
    },
    {
      "id": "dos-font",
      "type": "select",
      "label": {
        "en": "Font",
        "zh-Hans": "字体",

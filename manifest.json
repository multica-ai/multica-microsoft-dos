        {
          "value": "edit",
          "label": {
            "en": "MS-DOS Editor",
            "zh-Hans": "MS-DOS 编辑器",
            "zh-Hant": "MS-DOS 編輯器",
            "ja": "MS-DOS エディタ",
            "ko": "MS-DOS 편집기",
            "es": "Editor de MS-DOS",
            "fr": "Éditeur MS-DOS"
          },
          "swatch": "#0000AA"
        },
        {
          "value": "amber",
          "label": {
            "en": "Amber phosphor",
            "zh-Hans": "琥珀色荧光屏",
            "zh-Hant": "琥珀色螢光幕",
            "ja": "アンバー",
            "ko": "호박색 모니터",
            "es": "Fósforo ámbar",
            "fr": "Phosphore ambre"
          },
          "swatch": "#FFB000"
        },
        {
          "value": "green",
          "label": {
            "en": "Green phosphor",
            "zh-Hans": "绿色荧光屏",
            "zh-Hant": "綠色螢光幕",

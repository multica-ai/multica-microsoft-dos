        "ja": "フォント",
        "ko": "글꼴",
        "es": "Fuente",
        "fr": "Police"
      },
      "default": "vga",
      "choices": [
        {
          "value": "vga",
          "label": {
            "en": "IBM VGA 8×16",
            "zh-Hans": "IBM VGA 8×16",
            "zh-Hant": "IBM VGA 8×16",
            "ja": "IBM VGA 8×16",
            "ko": "IBM VGA 8×16",
            "es": "IBM VGA 8×16",
            "fr": "IBM VGA 8×16"
          }
        },
        {
          "value": "modern",
          "label": {
            "en": "Modern monospace",
            "zh-Hans": "现代等宽字体",
            "zh-Hant": "現代等寬字型",
            "ja": "モダンな等幅",
            "ko": "현대식 고정폭",
            "es": "Monoespaciada moderna",
            "fr": "Chasse fixe moderne"
          }
        }
      ]
